---
import type { Locale } from '../i18n/translations';
import { locales } from '../i18n/translations';
import { assets, industryImages, productImages, solutionImages } from '../data/assets';
import { getRoute } from '../data/routes';
import Hero from './Hero.astro';
import ResponsivePicture from './ResponsivePicture.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = locales[lang];
const nav = t.nav;
const rfq = getRoute('rfq', lang);
const company = getRoute('company', lang);
const solutions = getRoute('solutions', lang);
const products = getRoute('products', lang);
const procurement = getRoute('procurement', lang);
const industries = getRoute('industries', lang);
const contact = getRoute('contact', lang);
const en = lang === 'en';
---

<Hero lang={lang} />

<!-- 02 Trust strip -->
<section class="border-b border-coolgray-200 bg-white">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-y-6 px-4 py-8 sm:px-6 lg:grid-cols-4 lg:px-8">
    {t.trust.items.map((item) => (
      <div class="flex flex-col items-center gap-1 text-center lg:border-l lg:border-coolgray-200 lg:first:border-l-0">
        <span class="font-heading text-xl font-bold text-steel">{item.number}</span>
        <span class="text-xs font-medium text-coolgray-600">{item.label}</span>
      </div>
    ))}
  </div>
</section>

<!-- 03 Company introduction (editorial split) -->
<section class="relative overflow-hidden bg-white py-16 lg:py-28">
  <div aria-hidden="true" class="absolute -right-40 top-10 h-64 w-[40rem] rotate-[-8deg] rounded-[50%] border-t border-silver-200"></div>
  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-20 lg:px-8">
    <div class="max-w-xl">
      <p class="section-eyebrow">{t.intro.eyebrow}</p>
      <h2 class="section-title mt-4">{t.intro.title}</h2>
      <p class="section-body mt-6">{t.intro.body}</p>
      <div class="mt-8 space-y-0 border-t border-coolgray-200">
        {t.intro.features.map((feature) => (
          <div class="flex gap-5 border-b border-coolgray-200 py-5">
            <span aria-hidden="true" class="mt-1 h-2 w-2 shrink-0 rounded-full bg-steel"></span>
            <div>
              <h3 class="font-heading text-base font-bold text-navy">{feature.title}</h3>
              <p class="mt-1 text-sm leading-6 text-coolgray-700">{feature.body}</p>
            </div>
          </div>
        ))}
      </div>
      <a href={company} class="btn-navy mt-9">{t.intro.cta}<span aria-hidden="true">→</span></a>
    </div>
    <div class="relative">
      <ResponsivePicture
        image={assets.about.operations}
        alt={en ? 'Industrial supply operations coordinated by NBL' : 'Opérations de fourniture industrielle coordonnées par NBL'}
        width="1600" height="900" loading="lazy" decoding="async"
        class="aspect-[16/10] w-full rounded-md object-cover object-center shadow-[0_18px_50px_rgba(7,23,42,0.09)]"
      />
      <ResponsivePicture
        image={assets.about.team}
        alt=""
        width="1600" height="900" loading="lazy" decoding="async"
        pictureClass="absolute -bottom-8 -left-4 hidden w-[46%] sm:block lg:-left-12"
        class="w-full rounded-md border-4 border-white object-cover shadow-[0_18px_50px_rgba(7,23,42,0.12)]"
      />
    </div>
  </div>
</section>

<!-- 04 Core solutions grid -->
<section class="bg-coolgray-100 py-16 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="section-eyebrow">{t.solutions.eyebrow}</p>
        <h2 class="section-title mt-4">{t.solutions.title}</h2>
      </div>
      <a href={solutions} class="btn-navy shrink-0">{en ? 'All Solutions' : 'Toutes les solutions'}<span aria-hidden="true">→</span></a>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {t.solutions.items.map((solution, i) => (
        <a
          href={solutions}
          class="group relative overflow-hidden rounded-md bg-white shadow-[0_10px_30px_rgba(7,23,42,0.06)] transition-transform duration-300 hover:-translate-y-1 hover:shadow-[0_18px_50px_rgba(7,23,42,0.12)]"
        >
          <div class="aspect-[16/9] overflow-hidden">
            <ResponsivePicture image={solutionImages[i]} alt="" width="1600" height="900" loading="lazy" decoding="async" pictureClass="block h-full w-full" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </div>
          <div class="flex items-start justify-between gap-4 p-6">
            <div>
              <h3 class="font-heading text-lg font-bold text-navy transition-colors group-hover:text-steel">{solution.title}</h3>
              <p class="mt-2 text-sm leading-6 text-coolgray-700">{solution.description}</p>
            </div>
            <span aria-hidden="true" class="mt-1 shrink-0 text-steel transition-transform duration-300 group-hover:translate-x-1.5">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- 05 Product categories (technical grid) -->
<section class="bg-white py-16 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="section-eyebrow">{t.products.eyebrow}</p>
        <h2 class="section-title mt-4">{t.products.title}</h2>
        <p class="section-body mt-4 text-[1rem]">{t.products.description}</p>
      </div>
      <a href={products} class="btn-navy shrink-0">{en ? 'Browse Products' : 'Voir les produits'}<span aria-hidden="true">→</span></a>
    </div>
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {t.products.categories.map((category, i) => (
        <a href={products} class="group relative overflow-hidden rounded-md">
          <ResponsivePicture image={productImages[i]} alt="" width="1600" height="900" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-950/88 via-navy-950/22 to-transparent"></div>
          <div class="absolute inset-0 flex flex-col justify-end p-5">
            <h3 class="font-heading text-base font-bold text-white">{category.title}</h3>
            <p class="mt-1.5 text-xs leading-5 text-white/75 line-clamp-2">{category.description}</p>
          </div>
        </a>
      ))}
    </div>
    <p class="mt-6 text-xs italic text-coolgray-500">{en ? 'Available subject to specification, sourcing and supplier availability.' : 'Disponible sous réserve de spécification, de recherche produit et de disponibilité fournisseur.'}</p>
  </div>
</section>

<!-- 06 Procurement workflow (navy band, image split) -->
<section class="bg-navy py-16 text-white lg:py-28">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_0.85fr] lg:gap-20 lg:px-8">
    <div>
      <p class="section-eyebrow !text-steel-200">{t.procurement.eyebrow}</p>
      <h2 class="section-title mt-4 !text-white">{t.procurement.title}</h2>
      <p class="section-body mt-5 !text-silver-200">{t.procurement.description}</p>
      <ol class="mt-10 grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
        {t.procurement.steps.map((step) => (
          <li class="border-t border-white/15 pt-4">
            <span class="font-heading text-sm font-bold text-steel-200">{step.number}</span>
            <h3 class="mt-1.5 font-heading text-sm font-bold text-white">{step.title}</h3>
            <p class="mt-1.5 text-xs leading-5 text-silver-300">{step.description}</p>
          </li>
        ))}
      </ol>
      <div class="mt-10 flex flex-wrap gap-3.5">
        <a href={rfq} class="btn-primary">{en ? 'Start an RFQ' : 'Lancer un RFQ'}<span aria-hidden="true">→</span></a>
        <a href={procurement} class="btn-secondary">{nav.procurement}</a>
      </div>
    </div>
    <div class="relative">
      <ResponsivePicture image={assets.procurement.warehouse} alt={en ? 'Procurement warehouse operations' : 'Opérations d\'entrepôt et d\'approvisionnement'} width="1600" height="900" loading="lazy" decoding="async" class="aspect-[4/5] w-full rounded-md object-cover lg:shadow-[0_25px_70px_rgba(0,0,0,0.35)]" />
      <ResponsivePicture image={assets.procurement.logistics} alt="" width="1600" height="900" loading="lazy" decoding="async" pictureClass="absolute -bottom-8 -left-6 hidden w-1/2 lg:block" class="w-full rounded-md border-4 border-navy object-cover shadow-xl" />
    </div>
  </div>
</section>

<!-- 07 Industries served (image cards) -->
<section class="bg-coolgray-100 py-16 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="section-eyebrow">{t.industries.eyebrow}</p>
        <h2 class="section-title mt-4">{t.industries.title}</h2>
      </div>
      <a href={industries} class="btn-navy shrink-0">{en ? 'All Industries' : 'Tous les secteurs'}<span aria-hidden="true">→</span></a>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {t.industries.items.map((industry, i) => (
        <a href={industries} class={`group relative overflow-hidden rounded-md ${i === 0 ? 'md:col-span-2 lg:col-span-1' : ''}`}>
          <ResponsivePicture image={industryImages[i]} alt="" width="1600" height="900" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-950/85 via-navy-950/18 to-transparent"></div>
          <div class="absolute inset-0 flex flex-col justify-end p-6">
            <h3 class="font-heading text-xl font-bold text-white">{industry.title}</h3>
            <p class="mt-2 max-w-md text-sm leading-6 text-white/82">{industry.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- 08 Capabilities (editorial) -->
<section class="bg-white py-16 lg:py-28">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-20 lg:px-8">
    <div class="relative order-2 lg:order-1">
      <ResponsivePicture image={assets.industries.maintenance} alt={en ? 'Field support for industrial operations' : 'Soutien terrain pour opérations industrielles'} width="1600" height="900" loading="lazy" decoding="async" class="aspect-[16/10] w-full rounded-md object-cover shadow-[0_18px_50px_rgba(7,23,42,0.09)]" />
    </div>
    <div class="order-1 lg:order-2">
      <p class="section-eyebrow">{t.capabilities.eyebrow}</p>
      <h2 class="section-title mt-4">{t.capabilities.title}</h2>
      <p class="section-body mt-6">{t.capabilities.description}</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {t.capabilities.items.map((item) => (
          <div class="rounded-md border border-coolgray-200 bg-coolgray-50 p-5 transition-colors hover:border-steel-300">
            <h3 class="font-heading text-sm font-bold text-navy">{item.title}</h3>
            <p class="mt-1.5 text-xs leading-5 text-coolgray-700">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- 09 Why NBL -->
<section class="bg-coolgray-100 py-16 lg:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="section-eyebrow justify-center">{t.why.eyebrow}</p>
      <h2 class="section-title mt-4">{t.why.title}</h2>
    </div>
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {t.why.reasons.map((reason, i) => (
        <div class="relative rounded-md border-t-2 border-steel bg-white p-6 shadow-[0_10px_30px_rgba(7,23,42,0.05)]">
          <span class="font-heading text-4xl font-bold text-coolgray-200">0{i + 1}</span>
          <h3 class="mt-3 font-heading text-base font-bold text-navy">{reason.title}</h3>
          <p class="mt-2 text-sm leading-6 text-coolgray-700">{reason.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- 10 DRC positioning (full-width image band) -->
<section class="relative isolate overflow-hidden">
  <ResponsivePicture image={assets.industries.mining} alt="" width="1600" height="900" loading="lazy" decoding="async" pictureClass="absolute inset-0 -z-20 block h-full w-full" class="h-full w-full object-cover" />
  <div class="absolute inset-0 -z-10 bg-navy-950/62"></div>
  <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 lg:py-28">
    <p class="text-xs font-bold tracking-[0.24em] text-steel-200">LUBUMBASHI • {en ? 'DRC' : 'RDC'}</p>
    <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl lg:text-5xl">
      {en ? 'An industrial supply partner based in the heart of the Copperbelt' : 'Un partenaire de fourniture industrielle au cœur de la ceinture de cuivre'}
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-white/85 sm:text-lg sm:leading-8">
      {en
        ? 'Operating from Lubumbashi, Haut-Katanga, NBL works alongside mining, processing and industrial projects across the Democratic Republic of the Congo.'
        : 'Basée à Lubumbashi, Haut-Katanga, NBL accompagne les projets miniers, de traitement et industriels à travers la République démocratique du Congo.'}
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3.5">
      <a href={rfq} class="btn-primary">{nav.rfq}<span aria-hidden="true">→</span></a>
      <a href={contact} class="btn-secondary">{nav.contact}</a>
    </div>
  </div>
</section>

<!-- 11 RFQ conversion (steel) -->
<section class="bg-steel-700 py-16 text-white lg:py-24">
  <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8">
    <div>
      <p class="text-xs font-bold tracking-[0.22em] text-white/70">{t.rfq.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-bold leading-tight sm:text-4xl">{t.rfq.title}</h2>
      <p class="mt-5 max-w-xl text-base leading-7 text-white/85">{t.rfq.description}</p>
      <a href={rfq} class="btn-light mt-8">{t.rfq.submit}<span aria-hidden="true">→</span></a>
    </div>
    <ResponsivePicture image={assets.solutions.industrialSupply} alt="" width="1600" height="900" loading="lazy" decoding="async" pictureClass="hidden lg:block" class="aspect-[16/11] w-full rounded-md object-cover" />
  </div>
</section>
