---
interface Props {
  title: string;
  description?: string;
  tone?: 'navy' | 'steel';
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const { title, description, tone = 'navy', primary, secondary } = Astro.props;
const isNavy = tone === 'navy';
---

<section class={`relative isolate overflow-hidden ${isNavy ? 'bg-navy' : 'bg-steel-700'}`}>
  <div aria-hidden="true" class={`absolute -right-32 -top-24 h-64 w-[42rem] rotate-[-8deg] rounded-[50%] border-t ${isNavy ? 'border-white/15' : 'border-white/20'}`}></div>
  <div class="relative mx-auto flex max-w-7xl flex-col items-center gap-8 px-4 py-16 text-center sm:px-6 lg:flex-row lg:justify-between lg:px-8 lg:py-20 lg:text-left">
    <div class="max-w-2xl">
      <h2 class={`text-3xl font-bold leading-tight sm:text-4xl ${isNavy ? 'text-white' : 'text-white'}`}>{title}</h2>
      {description && <p class={`mt-4 text-base leading-7 sm:text-lg ${isNavy ? 'text-silver-200' : 'text-white/80'}`}>{description}</p>}
    </div>
    <div class="flex shrink-0 flex-wrap justify-center gap-3.5">
      <a href={primary.href} class={isNavy ? 'btn-light' : 'btn-light'}>
        {primary.label}
        <span aria-hidden="true">→</span>
      </a>
      {secondary && <a href={secondary.href} class="btn-secondary">{secondary.label}</a>}
    </div>
  </div>
</section>
