---
import type { Locale } from '../i18n/translations';
import { locales } from '../i18n/translations';
import { getAlternateRoute, getRoute } from '../data/routes';
import { site } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = locales[lang].footer;
const nav = locales[lang].nav;
const otherLang: Locale = lang === 'en' ? 'fr' : 'en';
const otherLangLabel = lang === 'en' ? 'Français' : 'English';

const quickLinks = [
  ['company', nav.company],
  ['solutions', nav.solutions],
  ['products', nav.products],
  ['procurement', nav.procurement],
  ['industries', nav.industries],
  ['capabilities', nav.capabilities],
] as const;

const solutionLinks = [
  { label: lang === 'en' ? 'Industrial Supply' : 'Fourniture industrielle', id: 'industrial-supply' },
  { label: lang === 'en' ? 'Procurement' : 'Approvisionnement', id: 'procurement' },
  { label: lang === 'en' ? 'Product Sourcing' : 'Recherche de produits', id: 'product-sourcing' },
  { label: lang === 'en' ? 'Conveyor Components' : 'Composants de convoyeurs', id: 'conveyor-mechanical' },
];
---

<footer class="relative overflow-hidden bg-navy-950 text-white">
  <div aria-hidden="true" class="absolute -right-40 top-8 h-72 w-[42rem] rotate-[-8deg] rounded-[50%] border-t border-white/10"></div>

  <div class="relative border-b border-white/12 bg-navy/45">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-9 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
      <div>
        <p class="mb-2 text-xs font-bold tracking-[0.2em] text-steel-300">{lang === 'en' ? 'INDUSTRIAL REQUIREMENTS' : 'BESOINS INDUSTRIELS'}</p>
        <h2 class="text-2xl font-bold text-white md:text-3xl">{lang === 'en' ? 'Bring us the requirement. We will coordinate the next step.' : 'Transmettez-nous votre besoin. Nous coordonnerons la suite.'}</h2>
      </div>
      <a href={getRoute('rfq', lang)} class="btn-primary shrink-0">
        {nav.rfq}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="relative mx-auto grid max-w-7xl grid-cols-1 gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-[1.35fr_0.8fr_0.95fr_1.1fr] lg:px-8 lg:py-16">
    <div>
      <a href={getRoute('home', lang)} class="inline-block" aria-label={`${site.name} - ${nav.home}`}>
        <img src={site.logoWhite} width="305" height="86" alt="New Business Light sarl" class="h-16 w-auto" />
      </a>
      <p class="mt-5 max-w-sm text-sm leading-7 text-silver-300">{t.descriptor}</p>
      <p class="mt-6 text-xs font-semibold tracking-[0.22em] text-white/65">TRUST. STRENGTH. BUSINESS.</p>
    </div>

    <div>
      <h3 class="mb-5 text-xs font-bold tracking-[0.18em] text-white">{t.quickLinks.toUpperCase()}</h3>
      <ul class="space-y-3">
        {quickLinks.map(([key, label]) => (
          <li><a href={getRoute(key, lang)} class="text-sm text-silver-300 transition-colors hover:text-white">{label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mb-5 text-xs font-bold tracking-[0.18em] text-white">{t.solutions.toUpperCase()}</h3>
      <ul class="space-y-3">
        {solutionLinks.map((link) => (
          <li><a href={`${getRoute('solutions', lang)}#${link.id}`} class="text-sm text-silver-300 transition-colors hover:text-white">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mb-5 text-xs font-bold tracking-[0.18em] text-white">{t.contactTitle.toUpperCase()}</h3>
      <address class="space-y-4 text-sm not-italic leading-6 text-silver-300">
        <p><span class="block font-semibold text-white">{site.name}</span>{site.address.street}<br />{site.address.city}, {site.address.country}</p>
        <p><a href={site.phoneHref} class="transition-colors hover:text-white">{site.phone}</a></p>
        <p class="break-words"><a href={`mailto:${site.emails[0]}`} class="transition-colors hover:text-white">{site.emails[0]}</a><br /><a href={`mailto:${site.emails[1]}`} class="transition-colors hover:text-white">{site.emails[1]}</a></p>
      </address>
    </div>
  </div>

  <div class="relative border-t border-white/12">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-5 text-xs text-silver-400 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
      <p>© {new Date().getFullYear()} {site.name}. {lang === 'en' ? 'All rights reserved.' : 'Tous droits réservés.'}</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <a href={getRoute('privacy', lang)} class="transition-colors hover:text-white">{t.privacy}</a>
        <a href={getRoute('terms', lang)} class="transition-colors hover:text-white">{t.terms}</a>
        <a href={getAlternateRoute(Astro.url.pathname, otherLang)} class="font-semibold text-white transition-colors hover:text-steel-200">{otherLangLabel}</a>
      </div>
    </div>
  </div>
</footer>
