---
import type { Locale } from '../i18n/translations';
import { locales } from '../i18n/translations';
import { getAlternateRoute, getRoute, getRouteKey, type RouteKey } from '../data/routes';
import { site } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = locales[lang].nav;
const currentKey = getRouteKey(Astro.url.pathname);
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const otherLang: Locale = lang === 'en' ? 'fr' : 'en';
const otherLangLabel = lang === 'en' ? 'FR' : 'EN';
const currentLangLabel = lang === 'en' ? 'EN' : 'FR';
const otherLangPath = `${getAlternateRoute(Astro.url.pathname, otherLang)}${Astro.url.search}`;

const navLinks: { key: RouteKey; label: string }[] = [
  { key: 'home', label: t.home },
  { key: 'company', label: t.company },
  { key: 'solutions', label: t.solutions },
  { key: 'products', label: t.products },
  { key: 'procurement', label: t.procurement },
  { key: 'industries', label: t.industries },
  { key: 'capabilities', label: t.capabilities },
  { key: 'contact', label: t.contact },
];

const menuLabel = lang === 'en' ? 'Open navigation' : 'Ouvrir la navigation';
const closeLabel = lang === 'en' ? 'Close navigation' : 'Fermer la navigation';
const navLabel = lang === 'en' ? 'Main navigation' : 'Navigation principale';
const languageLabel = lang === 'en' ? 'Afficher le site en français' : 'View site in English';
const languageHeading = lang === 'en' ? 'Language' : 'Langue';
const locationLabel = lang === 'en' ? 'Lubumbashi, DRC' : 'Lubumbashi, RDC';
const drawerTagline = lang === 'en' ? 'INDUSTRIAL SUPPLY IN THE DRC' : 'FOURNITURE INDUSTRIELLE EN RDC';
---

<header id="main-header" class="site-header sticky top-0 z-50 border-b border-navy/10 bg-white/94 backdrop-blur-xl">
  <div id="header-inner" class="header-inner relative mx-auto flex max-w-[1600px] items-center justify-between gap-3 px-4 sm:gap-4 sm:px-6 lg:px-8">
    <a href={getRoute('home', lang)} class="relative z-10 flex min-w-0 shrink items-center" aria-label={`${site.name} - ${t.home}`}>
      <img src={site.logo} width="595" height="125" alt="New Business Light sarl" class="h-8 w-auto max-w-[52vw] object-contain sm:h-10 xl:h-11" />
    </a>

    <nav class="hidden min-[1240px]:flex min-[1240px]:items-stretch min-[1240px]:self-stretch" aria-label={navLabel}>
      {navLinks.map((link) => {
        const href = getRoute(link.key, lang);
        const active = currentKey === link.key || currentPath === href;
        return (
          <a
            href={href}
            aria-current={active ? 'page' : undefined}
            class={`nav-link relative flex items-center px-2.5 text-[0.75rem] font-semibold text-navy-800 transition-colors hover:text-steel ${active ? 'is-active text-navy' : ''}`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="relative z-10 flex shrink-0 items-center gap-2 sm:gap-3">
      <a
        href={otherLangPath}
        class="language-pill inline-flex h-10 items-center gap-1.5 rounded-full border border-coolgray-200 bg-coolgray-50 px-3 text-[11px] font-bold tracking-[0.1em] text-navy shadow-sm transition hover:border-steel-200 hover:bg-white"
        aria-label={languageLabel}
      >
        <svg aria-hidden="true" class="hidden h-3.5 w-3.5 min-[380px]:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="1.7"/><path d="M3 12h18M12 3c2.4 2.5 3.6 5.5 3.6 9s-1.2 6.5-3.6 9c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3Z" stroke-width="1.7"/></svg>
        {otherLangLabel}
      </a>
      <a href={getRoute('rfq', lang)} class="btn-navy header-rfq group px-5">
        {t.rfq}
        <svg aria-hidden="true" class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 5 7 7-7 7" /></svg>
      </a>
      <button
        id="mobile-menu-btn"
        class="menu-button inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-coolgray-200 bg-white text-navy shadow-[0_8px_24px_rgba(7,23,42,0.1)] transition hover:border-steel-200 hover:bg-coolgray-50 min-[1240px]:hidden"
        aria-label={menuLabel}
        data-open-label={menuLabel}
        data-close-label={closeLabel}
        aria-expanded="false"
        aria-controls="mobile-menu"
        type="button"
      >
        <svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon-open" stroke-linecap="round" stroke-width="1.8" d="M5 7h14M5 12h14M5 17h14" />
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-width="1.8" d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  class="mobile-menu min-[1240px]:hidden"
  aria-hidden="true"
  inert
>
  <button class="mobile-menu-backdrop absolute inset-0" aria-label={closeLabel} data-menu-close type="button"></button>
  <nav
    class="mobile-menu-panel absolute inset-x-0 bottom-0 top-0 flex max-h-none flex-col overflow-y-auto overscroll-contain bg-white px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-6 shadow-[0_10px_60px_rgba(7,23,42,0.22)] sm:px-7"
    aria-label={navLabel}
  >
    <div class="mb-5 flex items-center gap-3">
      <span class="h-px w-8 bg-steel"></span>
      <p class="font-heading text-[10px] font-bold tracking-[0.22em] text-steel">{drawerTagline}</p>
    </div>

    <ul class="flex flex-col">
      {navLinks.map((link, i) => {
        const active = currentKey === link.key;
        return (
          <li>
            <a
              href={getRoute(link.key, lang)}
              aria-current={active ? 'page' : undefined}
              data-menu-link
              class={`mobile-nav-link group flex min-h-[3rem] items-center justify-between gap-4 py-2 pr-1 sm:min-h-[3.5rem] ${active ? '' : 'border-b border-coolgray-100'}`}
            >
              <span class="flex min-w-0 items-center gap-3 sm:gap-3.5">
                <span class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-lg font-heading text-[11px] font-bold sm:h-8 sm:w-8 ${active ? 'bg-navy text-white shadow-[0_6px_18px_rgba(10,46,91,0.28)]' : 'bg-navy-50 text-steel'}`}>{String(i + 1).padStart(2, '0')}</span>
                <span class={`truncate font-heading text-sm font-bold sm:text-[15px] ${active ? 'text-navy' : 'text-navy-800'}`}>{link.label}</span>
              </span>
              <span aria-hidden="true" class={`text-lg leading-none transition-transform group-hover:translate-x-0.5 ${active ? 'text-steel' : 'text-silver-400'}`}>›</span>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="mt-auto pt-4 sm:pt-6">
      <p class="mb-2.5 font-heading text-[10px] font-bold tracking-[0.22em] text-coolgray-500 sm:mb-3">{languageHeading}</p>
      <div class="flex items-center gap-2">
        <span aria-current="true" class="inline-flex h-10 min-w-14 items-center justify-center rounded-lg bg-navy px-3 font-heading text-xs font-bold tracking-wider text-white">{currentLangLabel}</span>
        <a
          href={otherLangPath}
          data-menu-link
          aria-label={languageLabel}
          class="inline-flex h-10 min-w-14 items-center justify-center rounded-lg border border-coolgray-200 bg-white px-3 font-heading text-xs font-bold tracking-wider text-navy transition hover:border-steel-300 hover:text-steel"
        >
          {otherLangLabel}
        </a>
      </div>

      <a href={getRoute('rfq', lang)} data-menu-link class="group mt-5 flex min-h-[3.5rem] w-full items-center justify-between rounded-xl bg-navy px-5 font-heading text-sm font-bold text-white shadow-[0_14px_34px_rgba(10,46,91,0.28)] transition hover:bg-navy-900">
        {t.rfq}
        <span aria-hidden="true" class="text-xl transition-transform group-hover:translate-x-1">→</span>
      </a>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-navy/10 pt-4 text-[11px] font-medium text-coolgray-600">
        <span class="inline-flex items-center gap-1.5">
          <svg aria-hidden="true" class="h-3.5 w-3.5 text-steel" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 21s-7-5.1-7-11a7 7 0 1 1 14 0c0 5.9-7 11-7 11Z"/><circle cx="12" cy="10" r="2.4"/></svg>
          {locationLabel}
        </span>
        <a class="text-steel hover:text-navy" href={`mailto:${site.emails[1]}`}>{site.emails[1]}</a>
      </div>
    </div>
  </nav>
</div>

<style>
  .site-header {
    transition: box-shadow 220ms ease, background-color 220ms ease;
  }
  .header-inner {
    height: 72px;
    transition: height 240ms cubic-bezier(.16, 1, .3, 1);
  }
  .site-header.is-scrolled {
    background: rgba(255, 255, 255, .985);
    box-shadow: 0 10px 35px rgba(7, 23, 42, .1);
  }
  .nav-link::after {
    position: absolute;
    right: .65rem;
    bottom: 0;
    left: .65rem;
    height: 2px;
    content: '';
    transform: scaleX(0);
    transform-origin: center;
    background: var(--color-navy);
    transition: transform 200ms ease;
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    top: 72px;
    height: auto;
    height: 100dvh;
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 260ms ease, visibility 0s linear 260ms;
  }
  .mobile-menu-backdrop {
    background: rgba(7, 23, 42, .32);
    backdrop-filter: blur(3px);
    border: 0;
    cursor: pointer;
  }
  .mobile-menu-panel {
    transform: translateY(-14px);
    opacity: 0;
    transition: transform 300ms cubic-bezier(.16, 1, .3, 1), opacity 220ms ease;
  }
  .mobile-menu.is-open {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    transition-delay: 0s;
  }
  .mobile-menu.is-open .mobile-menu-panel {
    transform: translateY(0);
    opacity: 1;
  }
  .header-rfq {
    display: none;
  }
  @media (min-width: 1240px) {
    .header-inner {
      height: 84px;
    }
    .site-header.is-scrolled .header-inner {
      height: 70px;
    }
    .header-rfq {
      display: inline-flex;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .header-inner,
    .mobile-menu,
    .mobile-menu-panel {
      transition: none;
    }
  }
</style>

<script>
  const header = document.getElementById('main-header');
  const menuBtn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const mobileMenu = document.getElementById('mobile-menu');
  const menuOpen = document.getElementById('menu-icon-open');
  const menuClose = document.getElementById('menu-icon-close');
  let isOpen = false;
  let savedScrollY = 0;

  const setMenu = (open: boolean, restoreFocus = true) => {
    if (open) savedScrollY = window.scrollY;
    isOpen = open;
    mobileMenu?.classList.toggle('is-open', open);
    mobileMenu?.setAttribute('aria-hidden', String(!open));
    mobileMenu?.toggleAttribute('inert', !open);
    menuOpen?.classList.toggle('hidden', open);
    menuClose?.classList.toggle('hidden', !open);
    menuBtn?.setAttribute('aria-expanded', String(open));
    menuBtn?.setAttribute('aria-label', open ? menuBtn.dataset.closeLabel ?? '' : menuBtn.dataset.openLabel ?? '');
    document.documentElement.style.overflow = open ? 'hidden' : '';
    if (open) mobileMenu?.querySelector<HTMLAnchorElement>('.mobile-nav-link')?.focus();
    else if (restoreFocus) {
      menuBtn?.focus();
      window.scrollTo(0, savedScrollY);
    }
  };

  menuBtn?.addEventListener('click', () => setMenu(!isOpen));
  mobileMenu?.querySelector('[data-menu-close]')?.addEventListener('click', () => setMenu(false));
  mobileMenu?.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', () => setMenu(false, false));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen) setMenu(false);
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1240 && isOpen) setMenu(false, false);
  });
  const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 48);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
</script>
