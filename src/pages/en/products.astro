---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHero from '../../components/InnerHero.astro';
import CTASection from '../../components/CTASection.astro';
import ResponsivePicture from '../../components/ResponsivePicture.astro';
import { pageHeroes, productImages } from '../../data/assets';
import { getRoute } from '../../data/routes';
import { locales } from '../../i18n/translations';

const lang = 'en' as const;
const t = locales[lang];
const categories = t.products.categories;
---

<BaseLayout
  title="Products | New Business Light sarl | Industrial Equipment & Components DRC"
  description="Product categories coordinated by NBL for DRC operations: conveyor components, scrapers, mechanical parts, industrial equipment, electrical and lighting, tools, safety equipment and special procurement."
  lang={lang}
  canonicalPath="/en/products"
  preloadImage={pageHeroes.products}
>
  <InnerHero
    lang={lang}
    eyebrow={t.products.eyebrow}
    title={t.products.title}
    description={t.products.description}
    image={pageHeroes.products}
    imagePosition="center 45%"
    overlayStrength="balanced"
  />

  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-5 sm:grid-cols-2">
        {categories.map((category, i) => (
          <article id={category.slug} class="group scroll-mt-28 overflow-hidden rounded-md border border-coolgray-200 bg-white shadow-[0_10px_30px_rgba(7,23,42,0.05)] transition-shadow hover:shadow-[0_18px_50px_rgba(7,23,42,0.11)]">
            <div class="relative aspect-[16/8] overflow-hidden">
              <ResponsivePicture image={productImages[i]} alt="" width="1600" height="900" loading="lazy" decoding="async" pictureClass="block h-full w-full" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <span class="absolute left-5 top-5 rounded-full bg-navy-950/55 px-3 py-1 font-heading text-[11px] font-bold tracking-widest text-white backdrop-blur-sm">0{i + 1}</span>
            </div>
            <div class="flex items-start justify-between gap-4 p-6">
              <div>
                <h2 class="font-heading text-lg font-bold text-navy">{category.title}</h2>
                <p class="mt-2 text-sm leading-6 text-coolgray-700">{category.description}</p>
                <p class="mt-3 text-xs italic text-coolgray-500">Available subject to specification, sourcing and supplier availability.</p>
              </div>
              <a href={getRoute('rfq', lang)} class="btn-navy shrink-0 !min-h-10 !px-4 !py-2.5 text-xs">Enquire<span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Don't see your product listed?"
    description="We source against specification. Send your requirement and we will identify suitable suppliers."
    tone="steel"
    primary={{ label: t.nav.rfq, href: getRoute('rfq', lang) }}
    secondary={{ label: t.nav.contact, href: getRoute('contact', lang) }}
  />
</BaseLayout>
