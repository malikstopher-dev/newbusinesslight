---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InnerHero from '../../components/InnerHero.astro';
import CTASection from '../../components/CTASection.astro';
import ResponsivePicture from '../../components/ResponsivePicture.astro';
import { assets, pageHeroes } from '../../data/assets';
import { getRoute } from '../../data/routes';
import { locales } from '../../i18n/translations';

const lang = 'fr' as const;
const t = locales[lang];
---

<BaseLayout
  title="Contact | New Business Light sarl | Fourniture industrielle RDC"
  description="Contactez New Business Light sarl à Lubumbashi, RDC, pour vos demandes de fourniture industrielle, d'approvisionnement et de sourcing."
  lang={lang}
  canonicalPath="/fr/contact"
  preloadImage={pageHeroes.contact}
>
  <InnerHero
    lang={lang}
    eyebrow={t.contact.eyebrow}
    title={t.contact.title}
    description={t.contact.description}
    image={pageHeroes.contact}
    imagePosition="center 60%"
    overlayStrength="balanced"
  />

  <section class="bg-white py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-5 md:grid-cols-3">
        <div class="rounded-md border-t-2 border-steel bg-coolgray-50 p-8">
          <span aria-hidden="true" class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-white text-steel shadow-sm">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5.1-7-11a7 7 0 1 1 14 0c0 5.9-7 11-7 11Z"/><circle cx="12" cy="10" r="2.6"/></svg>
          </span>
          <h2 class="font-heading text-base font-bold text-navy">{t.contact.address.title}</h2>
          <address class="mt-3 space-y-1 text-sm not-italic leading-6 text-coolgray-700">
            <p class="font-semibold text-navy">New Business Light sarl</p>
            <p>N°04, Av. Cascade, Quartier Makomeno</p>
            <p>Lubumbashi Haut, RDC</p>
          </address>
        </div>
        <div class="rounded-md border-t-2 border-steel bg-coolgray-50 p-8">
          <span aria-hidden="true" class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-white text-steel shadow-sm">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5.5C3 4.7 3.7 4 4.5 4h2.7c.7 0 1.3.5 1.5 1.2l1 3.1c.1.6-.1 1.2-.6 1.5l-1.5 1c1 2.2 2.9 4.1 5.1 5.1l1-1.5c.4-.5 1-.7 1.5-.6l3.1 1c.7.2 1.2.8 1.2 1.5v2.7c0 .8-.7 1.5-1.5 1.5h-1C9.7 21.5 3 14.8 3 6.5v-1Z"/></svg>
          </span>
          <h2 class="font-heading text-base font-bold text-navy">{t.contact.phone.title}</h2>
          <p class="mt-3 text-sm leading-6 text-coolgray-700">
            <a class="break-anywhere font-semibold text-steel" href="tel:+243990902654">+243 990 902 654</a>
          </p>
        </div>
        <div class="rounded-md border-t-2 border-steel bg-coolgray-50 p-8">
          <span aria-hidden="true" class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-white text-steel shadow-sm">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.9 5.3a2 2 0 0 0 2.2 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z"/></svg>
          </span>
          <h2 class="font-heading text-base font-bold text-navy">{t.contact.emails.title}</h2>
          <p class="mt-3 space-y-1 text-sm leading-6 text-coolgray-700">
            <a class="break-anywhere block font-semibold text-steel" href="mailto:newbusinesslight@gmail.com">newbusinesslight@gmail.com</a>
            <a class="break-anywhere block font-semibold text-steel" href="mailto:info@newbusinesslight.com">info@newbusinesslight.com</a>
          </p>
        </div>
      </div>
      <p class="mt-6 max-w-3xl text-xs leading-5 text-coolgray-500">
        Les coordonnées et horaires d'ouverture doivent être confirmés auprès de NBL avant toute visite ou livraison sensible aux délais.
      </p>
    </div>
  </section>

  <section class="bg-coolgray-100 py-16 lg:py-24">
    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-20 lg:px-8">
      <div>
        <p class="section-eyebrow">BASÉS À LUBUMBASHI</p>
        <h2 class="section-title mt-4">Depuis le pôle industriel du Haut-Katanga</h2>
        <p class="section-body mt-5">
          Notre bureau se situe dans le quartier Makomeno à Lubumbashi. De là, nous coordonnons les besoins de sites partout en République démocratique du Congo. Les visites sont possibles sur rendez-vous.
        </p>
      </div>
      <ResponsivePicture image={assets.about.team} alt="L'équipe NBL sur un site industriel en RDC" width="1600" height="900" loading="lazy" decoding="async" class="aspect-[16/10] w-full rounded-md object-cover shadow-[0_18px_50px_rgba(7,23,42,0.09)]" />
    </div>
  </section>

  <CTASection
    title="Besoin d'envoyer un cahier des charges complet ?"
    description="Le formulaire RFQ rassemble spécification, quantité et délais en un seul récapitulatif structuré."
    tone="steel"
    primary={{ label: t.nav.rfq, href: getRoute('rfq', lang) }}
  />
</BaseLayout>
